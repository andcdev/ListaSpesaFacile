# ── Dominio ──────────────────────────────────────────────────────────
# Locale:  SITE_ADDRESS=:80   APP_URL=http://localhost   sito vetrina su http://sito.localhost
# VPS:     dietro il proxy edge (repository edge_vps), che gestisce HTTPS e certificati:
#            COMPOSE_FILE=docker-compose.yml:docker-compose.edge.yml
#            SITE_ADDRESS=:80
#            SITE_HOST=listaspesafacile.com
#            APP_URL=https://api.listaspesafacile.com
SITE_ADDRESS=:80
SITE_HOST=sito.localhost
# Motori di ricerca sul sito vetrina: "si" per farlo indicizzare, altro (predefinito "no") per tenerli fuori.
SITE_INDEXABLE=no
APP_URL=http://localhost

# Chiave dell'app: l'API e il WebSocket rispondono 404 a chi non manda X-App-Key uguale a questa
# (tranne /auth/*, aperto dal browser per il login social). Vuota = controllo spento, comodo in locale.
# La stessa chiave va nella build:  flutter build appbundle --dart-define=CLIENT_KEY=…
# Genera con: openssl rand -hex 24
CLIENT_KEY=

# Genera con: echo "base64:$(openssl rand -base64 32)"
APP_KEY=

# ── Database ─────────────────────────────────────────────────────────
DB_DATABASE=listaspesa
DB_USERNAME=listaspesa
DB_PASSWORD=cambia-questa-password
DB_ROOT_PASSWORD=cambia-anche-questa

# phpMyAdmin ascolta solo su 127.0.0.1 del server (usa un tunnel SSH per aprirlo dal tuo PC).
PHPMYADMIN_PORT=8081

# ── WebSocket (Reverb) ───────────────────────────────────────────────
# Valori casuali: es. openssl rand -hex 16
REVERB_APP_ID=listaspesa
REVERB_APP_KEY=
REVERB_APP_SECRET=

# Come l'app raggiunge il WebSocket (passando da Caddy).
# Locale:  localhost / 80 / http        VPS: api.listaspesafacile.com / 443 / https
REVERB_PUBLIC_HOST=localhost
REVERB_PUBLIC_PORT=80
REVERB_PUBLIC_SCHEME=http

# ── Login con Google / Amazon (facoltativi) ───────────────
# URL di callback da registrare presso ogni provider: {APP_URL}/auth/{google|amazon}/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=

# ── Email (recupero password) ────────────────────────────────────────
# Con MAIL_MAILER=log le email non partono: il codice si legge con  docker compose logs app
# Per inviarle davvero usa un server SMTP, es. Gmail (password per le app), Brevo, Mailgun:
#   MAIL_MAILER=smtp  MAIL_HOST=smtp.gmail.com  MAIL_PORT=587
#   MAIL_USERNAME=tuoaccount@gmail.com  MAIL_PASSWORD=<password per le app>
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@listaspesafacile.com

# ── Notifiche push (facoltative) ──────────────────────────────────────
# Metti il file del service account Firebase in secrets/firebase-service-account.json
# (vedi secrets/README.md). Senza il file le notifiche arrivano solo con l'app aperta
# e i promemoria vengono programmati direttamente sul telefono.

# Controllo automatico delle foto (servizio "moderazione"): soglie da 0 a 1, sopra la foto è rifiutata e
# support@listaspesafacile.com (con copia ad andcecere@gmail.com) riceve un'email. MODERATION_URL= (vuoto) lo spegne.
#MODERATION_SEXUAL_THRESHOLD=0.8
#MODERATION_VIOLENCE_THRESHOLD=0.75
