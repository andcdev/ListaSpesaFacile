# ── Dominio ──────────────────────────────────────────────────────────
# Locale:  SITE_ADDRESS=:80              APP_URL=http://localhost
# VPS:     SITE_ADDRESS=spesa.tuodominio.it   APP_URL=https://spesa.tuodominio.it
SITE_ADDRESS=:80
APP_URL=http://localhost

# Genera con: echo "base64:$(openssl rand -base64 32)"
APP_KEY=

# ── Database ─────────────────────────────────────────────────────────
DB_DATABASE=listaspesa
DB_USERNAME=listaspesa
DB_PASSWORD=cambia-questa-password
DB_ROOT_PASSWORD=cambia-anche-questa

# phpMyAdmin ascolta solo su 127.0.0.1 del server (usa un tunnel SSH per aprirlo dal tuo PC).
PHPMYADMIN_PORT=8081

# ── WebSocket (Reverb) ───────────────────────────────────────────────
# Valori casuali: es. openssl rand -hex 16
REVERB_APP_ID=listaspesa
REVERB_APP_KEY=
REVERB_APP_SECRET=

# Come l'app raggiunge il WebSocket (passando da Caddy).
# Locale:  localhost / 80 / http        VPS: spesa.tuodominio.it / 443 / https
REVERB_PUBLIC_HOST=localhost
REVERB_PUBLIC_PORT=80
REVERB_PUBLIC_SCHEME=http

# ── Login con Google / Facebook / Amazon (facoltativi) ───────────────
# URL di callback da registrare presso ogni provider: {APP_URL}/auth/{google|facebook|amazon}/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=

# ── Email (recupero password) ────────────────────────────────────────
# Con MAIL_MAILER=log le email non partono: il codice si legge con  docker compose logs app
# Per inviarle davvero usa un server SMTP, es. Gmail (password per le app), Brevo, Mailgun:
#   MAIL_MAILER=smtp  MAIL_HOST=smtp.gmail.com  MAIL_PORT=587
#   MAIL_USERNAME=tuoaccount@gmail.com  MAIL_PASSWORD=<password per le app>
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@spesa.tuodominio.it

# ── Notifiche push (facoltative) ──────────────────────────────────────
# Metti il file del service account Firebase in secrets/firebase-service-account.json
# (vedi secrets/README.md). Senza il file le notifiche arrivano solo con l'app aperta
# e i promemoria vengono programmati direttamente sul telefono.
